<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Daily Planner (Web Prototype)</title>
<link rel="manifest" href="manifest.json">
<style>
  body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;margin:0;padding:0;background:#f6f7fb;color:#111}
  header{background:#3b82f6;color:#fff;padding:16px 14px}
  .container{padding:14px;max-width:820px;margin:0 auto}
  .row{display:flex;gap:8px;align-items:center}
  input,textarea,button,select{font:inherit}
  .task{background:#fff;padding:10px;border-radius:8px;margin-bottom:10px;display:flex;align-items:center;gap:10px;box-shadow:0 1px 3px rgba(0,0,0,.06)}
  .title{font-weight:600}
  .meta{color:#666;font-size:13px}
  .btn{background:#3b82f6;color:#fff;border:none;padding:8px 10px;border-radius:6px}
  .small{background:#e5e7eb;color:#111;padding:6px 8px;border-radius:6px;border:none}
  form{display:grid;gap:8px;margin-bottom:12px}
  .flex{display:flex;gap:8px}
</style>
</head>
<body>
<header><h1 style="margin:0;font-size:18px">Daily Planner (Web Prototype)</h1></header>
<div class="container">
  <form id="taskForm">
    <input id="title" placeholder="Task title" required />
    <textarea id="notes" rows="2" placeholder="Notes (optional)"></textarea>
    <div class="flex">
      <input id="due" type="datetime-local" />
      <label><input id="completed" type="checkbox"> Completed</label>
    </div>
    <div class="flex">
      <button class="btn" type="submit">Save Task</button>
      <button id="clear" class="small" type="button">Clear Form</button>
      <button id="reqPerm" class="small" type="button">Enable Notifications</button>
    </div>
  </form>

  <h3>Tasks</h3>
  <div id="list"></div>
  <p style="color:#666;font-size:13px">Tip: Add to Home Screen to use like an app. Notifications here work while the page is open.</p>
</div>

<script>
/* Simple task model + storage + in-page scheduled notifications */
const LS_KEY = 'daily_planner_tasks_v1';
let tasks = JSON.parse(localStorage.getItem(LS_KEY) || '[]').map(t => ({...t, dueDate: t.dueDate ? new Date(t.dueDate) : null}));
const timers = new Map();
const listEl = document.getElementById('list');
const form = document.getElementById('taskForm');
const titleEl = document.getElementById('title');
const notesEl = document.getElementById('notes');
const dueEl = document.getElementById('due');
const completedEl = document.getElementById('completed');
const reqPermBtn = document.getElementById('reqPerm');
let editId = null;

function saveStore(){ localStorage.setItem(LS_KEY, JSON.stringify(tasks)); render(); }

function scheduleNotification(task){
  clearScheduled(task.id);
  if(!task.dueDate) return;
  const ms = new Date(task.dueDate) - new Date();
  if(ms <= 0) return;
  const t = setTimeout(()=> {
    showNotification(task);
    timers.delete(task.id);
  }, ms);
  timers.set(task.id, t);
}

function clearScheduled(id){
  if(timers.has(id)){ clearTimeout(timers.get(id)); timers.delete(id); }
}

function showNotification(task){
  if(!('Notification' in window)) return;
  if(Notification.permission === 'granted'){
    new Notification(task.title || 'Task', { body: task.notes || '', tag: task.id });
  } else {
    alert('Reminder: ' + (task.title || 'Task') + (task.notes ? '\n' + task.notes : ''));
  }
}

function render(){
  listEl.innerHTML = '';
  tasks.sort((a,b)=>{
    if(a.dueDate && b.dueDate) return new Date(a.dueDate) - new Date(b.dueDate);
    if(a.dueDate) return -1;
    if(b.dueDate) return 1;
    return 0;
  });
  tasks.forEach(t=>{
    const el = document.createElement('div'); el.className='task';
    el.innerHTML = `
      <input type="checkbox" ${t.isCompleted ? 'checked' : ''} style="width:20px;height:20px">
      <div style="flex:1">
        <div class="title" ${t.isCompleted ? 'style="text-decoration:line-through;color:#888"' : ''}>${escapeHtml(t.title)}</div>
        <div class="meta">${t.dueDate ? formatDate(new Date(t.dueDate)) + (t.notes ? ' • ' + escapeHtml(t.notes) : '') : (t.notes ? escapeHtml(t.notes) : '')}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px">
        <button class="small edit">Edit</button>
        <button class="small delete">Delete</button>
      </div>
    `;
    // checkbox toggle
    el.querySelector('input[type=checkbox]').addEventListener('change', (e)=>{
      t.isCompleted = e.target.checked; saveStore();
    });
    el.querySelector('.edit').addEventListener('click', ()=> {
      startEdit(t);
    });
    el.querySelector('.delete').addEventListener('click', ()=> {
      if(confirm('Delete this task?')) { clearScheduled(t.id); tasks = tasks.filter(x => x.id !== t.id); saveStore(); }
    });
    listEl.appendChild(el);
  });
}

function startEdit(t){
  editId = t.id;
  titleEl.value = t.title;
  notesEl.value = t.notes || '';
  dueEl.value = t.dueDate ? toLocalInput(new Date(t.dueDate)) : '';
  completedEl.checked = !!t.isCompleted;
  window.scrollTo({top:0,behavior:'smooth'});
}

form.addEventListener('submit', e=>{
  e.preventDefault();
  const title = titleEl.value.trim();
  if(!title) return alert('Enter a title');
  const notes = notesEl.value.trim() || null;
  const due = dueEl.value ? new Date(dueEl.value) : null;
  const isCompleted = completedEl.checked;
  if(editId){
    const idx = tasks.findIndex(t=>t.id===editId);
    if(idx>=0){
      tasks[idx] = {...tasks[idx], title, notes, dueDate: due, isCompleted};
      scheduleNotification(tasks[idx]);
    }
  } else {
    const id = 't_'+Date.now()+'_'+Math.random().toString(36).slice(2,8);
    const task = { id, title, notes, dueDate: due, isCompleted:false };
    tasks.push(task);
    scheduleNotification(task);
  }
  editId = null;
  form.reset();
  saveStore();
});

document.getElementById('clear').addEventListener('click', ()=>{ editId=null; form.reset(); });

reqPermBtn.addEventListener('click', async ()=>{
  if(!('Notification' in window)) return alert('Notifications not supported in this browser.');
  const perm = await Notification.requestPermission();
  alert('Notification permission: ' + perm + '\nNote: scheduled reminders only fire while the page is open in this prototype.');
});

// helpers
function formatDate(d){
  return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
}
function toLocalInput(d){
  const tzOffset = d.getTimezoneOffset() * 60000;
  const localISO = (new Date(d - tzOffset)).toISOString().slice(0,16);
  return localISO;
}
function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

// initialize timers for existing tasks
tasks.forEach(t => {
  if(t.dueDate) scheduleNotification(t);
});
render();

// Install service worker (for PWA install and offline page)
if('serviceWorker' in navigator){
  navigator.serviceWorker.register('sw.js').catch(()=>{});
}
</script>
</body>
</html>